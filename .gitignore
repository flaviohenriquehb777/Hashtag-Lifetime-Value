# ==============================================================================
# .gitignore – Hashtag LTV Prediction
# ==============================================================================

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
.Python
develop-eggs/
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments -----------------------------------------------------
.venv/
venv/
ENV/
env/
.env

# --- Data & Model Artifacts (tracked by DVC, not Git) -------------------------
*.csv
*.pkl
*.joblib
*.h5
*.parquet
data/processed/*
!data/processed/.gitkeep
data/final/*
!data/final/.gitkeep
models/*.pkl
models/*.joblib

# --- Jupyter Notebooks --------------------------------------------------------
.ipynb_checkpoints/
notebooks/history_runs/

# --- IDE / OS -----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- MLflow -------------------------------------------------------------------
mlruns/
mlartifacts/

# --- DVC ----------------------------------------------------------------------
.dvc/tmp/
.dvc/cache/
/dvc.lock
!*.dvc
!.dvc/config
!.dvc/.gitignore
!.dvcignore

# --- Reports ------------------------------------------------------------------
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg

# --- Docker -------------------------------------------------------------------
*.log
docker-compose.override.yml

# --- Misc ---------------------------------------------------------------------
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
